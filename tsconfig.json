{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "vite.config.ts",
    "eslint.config.js"
  ],
  "exclude": [
    "src/pages",
    "src/contexts",
    "src/components/AppShell",
    "src/components/CTAIntermediario",
    "src/components/CartaAberta",
    "src/components/FAQ",
    "src/components/Features",
    "src/components/Hero",
    "src/components/Navbar",
    "src/components/Problema",
    "src/components/Roadmap",
    "src/components/Rodape",
    "src/components/Sistema",
    "src/components/layouts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
