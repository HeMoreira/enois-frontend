# @rede-enois/design-system is published on GitHub Packages, which REQUIRES A TOKEN to install,
# even though the package is public. Export a GitHub token with the `read:packages` scope as
# NODE_AUTH_TOKEN before `npm install` / `npm ci`; without it npm fails with E401 (see README).
@rede-enois:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
